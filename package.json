{
  "name": "dualtran-logseq",
  "version": "0.2.2",
  "description": "Bilingual translation for Logseq: keep the source block and add the translation underneath",
  "author": "seigwen",
  "license": "MPL-2.0",
  "private": true,
  "scripts": {
    "sync-core": "node scripts/sync-core.mjs",
    "dev": "node scripts/build-i18n.mjs && node esbuild.config.mjs",
    "build": "node scripts/build-i18n.mjs && node esbuild.config.mjs",
    "test": "vitest run",
    "test:dist": "node tests/dist/guards.mjs",
    "typecheck": "tsc --noEmit",
    "i18n:sync": "node scripts/locale-kit.mjs",
    "i18n:check": "node scripts/locale-kit.mjs --check",
    "e2e": "node e2e/settings-panel.mjs",
    "verify": "npm run i18n:build && npm run i18n:check && npm run typecheck && npm test && npm run build && npm run test:dist && npm run conformance",
    "i18n:build": "node scripts/build-i18n.mjs",
    "conformance": "vitest run tests/conformance/settings.test.ts"
  },
  "logseq": {
    "id": "dualtran-translate",
    "title": "DualTran Translate",
    "icon": "./icon.png",
    "main": "dist/index.html"
  },
  "dependencies": {
    "dualtran": "file:vendor/dualtran-core.tgz"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^3.0.82",
    "@ai-sdk/azure": "^3.0.71",
    "@ai-sdk/cohere": "^3.0.38",
    "@ai-sdk/deepinfra": "^2.0.54",
    "@ai-sdk/deepseek": "^2.0.35",
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/groq": "^3.0.41",
    "@ai-sdk/mistral": "^3.0.39",
    "@ai-sdk/openai": "^3.0.69",
    "@ai-sdk/perplexity": "^2.0.35",
    "@ai-sdk/togetherai": "^2.0.55",
    "@ai-sdk/xai": "^3.0.93",
    "@logseq/libs": "^0.0.17",
    "@types/node": "^26.6.5",
    "ai": "^6.0.199",
    "common-tags": "^1.8.2",
    "esbuild": "^0.21.5",
    "jsdom": "^24.1.3",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  }
}
